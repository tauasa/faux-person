SELECT ?g ?nat (GROUP_CONCAT(DISTINCT STR(?en); separator="|") AS ?names) (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q159 wd:Q15180 wd:Q34266 wd:Q212 wd:Q184 wd:Q232 wd:Q265 wd:Q813 wd:Q863 wd:Q874 wd:Q227 wd:Q399 wd:Q230 wd:Q217 wd:Q37 wd:Q211 wd:Q191 } ?p wdt:P27 ?c; wdt:P735 ?g. ?g rdfs:label ?nat. FILTER(LANG(?nat)="ru") ?g rdfs:label ?en. FILTER(LANG(?en) IN ("en","mul")) } GROUP BY ?g ?nat ORDER BY DESC(?n)
