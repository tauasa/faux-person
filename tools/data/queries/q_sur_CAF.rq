SELECT ?c ?name (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q916 wd:Q1009 wd:Q929 wd:Q657 wd:Q971 wd:Q974 wd:Q983 wd:Q1000 wd:Q1039 } ?p wdt:P27 ?c. ?p wdt:P734 ?f. ?f wdt:P31/wdt:P279* wd:Q101352; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name HAVING(COUNT(DISTINCT ?p) >= 2) ORDER BY ?c DESC(?n)
