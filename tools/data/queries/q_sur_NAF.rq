SELECT ?c ?name (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q1028 wd:Q262 wd:Q948 wd:Q1016 wd:Q79 wd:Q1049 wd:Q6250 } ?p wdt:P27 ?c. ?p wdt:P734 ?f. ?f wdt:P31/wdt:P279* wd:Q101352; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name HAVING(COUNT(DISTINCT ?p) >= 2) ORDER BY ?c DESC(?n)
