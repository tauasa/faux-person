SELECT ?c ?name ?type (COUNT(DISTINCT ?p) AS ?n) WHERE { { VALUES ?c { wd:Q219060 wd:Q407199 wd:Q193714 } ?p wdt:P27 ?c } UNION { ?p wdt:P172 wd:Q11390. BIND(wd:Q11390 AS ?c) } VALUES ?type {wd:Q12308941 wd:Q11879590 wd:Q3409032} ?p wdt:P735 ?g. ?g wdt:P31 ?type; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name ?type HAVING(COUNT(DISTINCT ?p) >= 2) ORDER BY ?c DESC(?n)
