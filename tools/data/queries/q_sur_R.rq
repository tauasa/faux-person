SELECT ?c ?name (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q159 wd:Q15180 wd:Q34266 wd:Q212 wd:Q184 wd:Q232 wd:Q265 wd:Q813 wd:Q863 wd:Q874 wd:Q227 wd:Q399 wd:Q230 wd:Q217 wd:Q37 wd:Q211 wd:Q191 } ?p wdt:P27 ?c; wdt:P734 ?f. ?f wdt:P31/wdt:P279* wd:Q101352; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name HAVING(COUNT(DISTINCT ?p) >= 3) ORDER BY ?c DESC(?n)
