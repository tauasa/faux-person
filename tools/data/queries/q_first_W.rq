SELECT ?c ?name ?type (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q30 wd:Q16 wd:Q96 wd:Q155 wd:Q414 wd:Q298 wd:Q739 wd:Q419 wd:Q717 wd:Q736 wd:Q77 wd:Q733 wd:Q750 wd:Q241 wd:Q786 wd:Q1183 wd:Q800 wd:Q804 wd:Q774 wd:Q783 wd:Q792 wd:Q811 wd:Q145 wd:Q27 wd:Q142 wd:Q183 wd:Q38 wd:Q29 wd:Q45 wd:Q55 wd:Q31 wd:Q32 wd:Q39 wd:Q40 wd:Q35 wd:Q34 wd:Q20 wd:Q33 wd:Q189 wd:Q36 wd:Q213 wd:Q214 wd:Q28 wd:Q218 wd:Q219 wd:Q41 wd:Q224 wd:Q215 wd:Q403 wd:Q225 wd:Q236 wd:Q221 wd:Q222 wd:Q233 wd:Q408 wd:Q664 } VALUES ?type {wd:Q12308941 wd:Q11879590 wd:Q3409032} ?p wdt:P27 ?c; wdt:P735 ?g. ?g wdt:P31 ?type; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name ?type HAVING(COUNT(DISTINCT ?p) >= 3) ORDER BY ?c DESC(?n)
