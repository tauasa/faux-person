SELECT ?c ?name ?type (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q148 wd:Q865 wd:Q8646 wd:Q668 wd:Q17 wd:Q884 wd:Q881 wd:Q928 wd:Q252 wd:Q869 wd:Q833 wd:Q334 wd:Q843 wd:Q902 wd:Q854 wd:Q837 wd:Q836 wd:Q424 wd:Q711 wd:Q819 } VALUES ?type {wd:Q12308941 wd:Q11879590 wd:Q3409032} ?p wdt:P27 ?c; wdt:P735 ?g. ?g wdt:P31 ?type; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name ?type HAVING(COUNT(DISTINCT ?p) >= 3) ORDER BY ?c DESC(?n)
