SELECT ?g ?nat (GROUP_CONCAT(DISTINCT STR(?en); separator="|") AS ?names) (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q1028 wd:Q262 wd:Q948 wd:Q1016 wd:Q79 wd:Q1049 wd:Q6250 } ?p wdt:P27 ?c; wdt:P734 ?g. ?g rdfs:label ?nat. FILTER(LANG(?nat)="ar") ?g rdfs:label ?en. FILTER(LANG(?en) IN ("en","mul")) } GROUP BY ?g ?nat ORDER BY DESC(?n)
