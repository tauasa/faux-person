SELECT ?c ?name ?type (COUNT(DISTINCT ?p) AS ?n) WHERE { VALUES ?c { wd:Q159 wd:Q15180 wd:Q34266 wd:Q212 wd:Q184 wd:Q232 wd:Q265 wd:Q813 wd:Q863 wd:Q874 wd:Q227 wd:Q399 wd:Q230 wd:Q217 wd:Q37 wd:Q211 wd:Q191 } VALUES ?type {wd:Q12308941 wd:Q11879590 wd:Q3409032} ?p wdt:P27 ?c; wdt:P735 ?g. ?g wdt:P31 ?type; rdfs:label ?name. FILTER(LANG(?name) IN ("en","mul")) } GROUP BY ?c ?name ?type HAVING(COUNT(DISTINCT ?p) >= 3) ORDER BY ?c DESC(?n)
